# Copy to .env.local for local development. In production set these in
# Vercel: Project > Settings > Environment Variables.
# Stripe and Square keys are NOT set here. They are entered in Settings > Integrations.

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Encrypts every key saved in Settings > Integrations. Generate with:
#   openssl rand -hex 32
# Do not lose or change it after keys are saved, or they must be re-entered.
INTEGRATION_ENCRYPTION_KEY=64-hex-characters

# Public URL of the deployed site, no trailing slash. Used to show webhook URLs
# and to verify Square webhook signatures.
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# Protects cron endpoints (used from Phase 1 on)
CRON_SECRET=any-long-random-string
